{
  "$schema": "./profile.schema.json",
  "id": "sysrepo-netopeer2",
  "vendor": "CESNET (open source)",
  "description": "netopeer2 NETCONF server on sysrepo: the reference open-source implementation.",
  "status": "verified",
  "testedWith": [{ "model": "sysrepo/sysrepo-netopeer2 Docker image", "version": "netopeer2 2.1.49, sysrepo 2.2.36, libyang 2.1.30 (sha256:36cc1d841c97f118d62f775024d60fb1ce210c3bca6b32135c1a9e5a358a1cc9)" }],
  "match": { "anyModule": ["sysrepo-plugind"] },
  "connection": { "port": 830 },
  "workflow": { "editTarget": "candidate", "lock": true, "validate": true, "commit": true },
  "paths": {
    "nacmGroups": "/ietf-netconf-acm:nacm/groups",
    "sessions": "/ietf-netconf-monitoring:netconf-state/sessions",

    "nacmWriteDefault": "/ietf-netconf-acm:nacm/write-default",
    "nacmExecDefault": "/ietf-netconf-acm:nacm/exec-default",
    "nacmDeniedOperations": "/ietf-netconf-acm:nacm/denied-operations",
    "netconfStartTime": "/ietf-netconf-monitoring:netconf-state/statistics/netconf-start-time",
    "netconfInRpcs": "/ietf-netconf-monitoring:netconf-state/statistics/in-rpcs",
    "netconfInSessions": "/ietf-netconf-monitoring:netconf-state/statistics/in-sessions",
    "labTransport": "/nn-lab:lab/transport",
    "labUplink": "/nn-lab:lab/uplink",
    "labMtu": "/nn-lab:lab/mtu",
    "labAddress": "/nn-lab:lab/address/ip",
    "oven": "/oven:oven/{{leaf}}",
    "ovenActualTemperature": "/oven:oven-state/temperature",
    "ovenFoodInside": "/oven:oven-state/food-inside",

    "interface": "/ietf-interfaces:interfaces/interface[name={{ifName}}]",
    "ifDescription": "/ietf-interfaces:interfaces/interface[name={{ifName}}]/description",
    "ifType": "/ietf-interfaces:interfaces/interface[name={{ifName}}]/type",
    "ifEnabled": "/ietf-interfaces:interfaces/interface[name={{ifName}}]/enabled",
    "ifLabTag": "/ietf-interfaces:interfaces/interface[name={{ifName}}]/nn-lab:lab-tag",
    "ifAddress": "/ietf-interfaces:interfaces/interface[name={{ifName}}]/ietf-ip:ipv4/address[ip={{ip}}]",
    "nacmGroup": "/ietf-netconf-acm:nacm/groups/group[name={{group}}]",
    "nacmRuleList": "/ietf-netconf-acm:nacm/rule-list[name={{ruleList}}]",
    "session": "/ietf-netconf-monitoring:netconf-state/sessions/session[session-id={{id}}]",
    "schema": "/ietf-netconf-monitoring:netconf-state/schemas/schema[identifier={{module}}]",
    "datastore": "/ietf-netconf-monitoring:netconf-state/datastores/datastore[name={{datastore}}]",
    "endpoint": "/ietf-netconf-server:netconf-server/listen/endpoint[name={{endpoint}}]",
    "key": "/ietf-keystore:keystore/asymmetric-keys/asymmetric-key[name={{key}}]",
    "labDnsServer": "/nn-lab:lab/dns-server[.={{server}}]",
    "labRule": "/nn-lab:lab/rule[name={{rule}}]",
    "labRuleAction": "/nn-lab:lab/rule[name={{rule}}]/action",
    "labRoute": "/nn-lab:lab/route[prefix={{prefix}}][next-hop={{nextHop}}]",
    "labUser": "/nn-lab:lab/user[name={{user}}]",
    "labEntry": "/nn-lab:lab/entry[id={{id}}]"
  }
}
